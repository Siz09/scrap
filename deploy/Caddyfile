# HTTPS for the DeviceScout website. Caddy gets and renews a certificate for $DOMAIN
# automatically, as long as the domain's DNS points at this server and ports 80/443 are open.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy web:8765
}
