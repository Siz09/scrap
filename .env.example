# Optional. Copy to .env (same folder as docker-compose.yml); docker compose reads it automatically.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS/Linux:         cp .env.example .env

# How often the scraper updates everything (30m, 6h, 1d ...)
SCRAPE_EVERY=6h

# Port for the website on this machine (http://localhost:8765)
WEB_PORT=8765

# Database password, and the port database tools (DBeaver, pgAdmin, psql) use on this machine.
# If a port is already in use, pick any other free one.
# Changing the password after the first start needs the database volume recreated.
POSTGRES_PASSWORD=devicescout
DB_PORT=55432

# Optional, paid: enables Firecrawl as the last-resort scraper
FIRECRAWL_API_KEY=
