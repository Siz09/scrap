# Copy to .env (same folder as docker-compose.yml); docker compose reads it automatically.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS/Linux:         cp .env.example .env

# Optional. Leave empty on your own machine: Check/Update just work.
# Set a long random value before the site is reachable from the internet; you then type it on Data sources.
DEVICESCOUT_ADMIN_KEY=

# How often the scraper updates prices (30m, 6h, 1d ...)
SCRAPE_EVERY=6h

# Port for the website on this machine
WEB_PORT=8765

# For HTTPS with --profile https: your domain, pointed at this server
DOMAIN=

# Optional, paid: enables Firecrawl as the last-resort scraper
FIRECRAWL_API_KEY=
